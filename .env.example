# LOCAL DEVELOPMENT ONLY. Change these credentials before any VPS deployment.
DATABASE_URL=postgresql://geen:geen_dev_only@127.0.0.1:5433/geen
# Only server-side variables: never use NEXT_PUBLIC_ for the API key.
# Read the current base URL from your YupiAI dashboard/docs. Must be HTTPS and end in /v1.
YUPIAI_API_KEY=
YUPIAI_BASE_URL=

# Autonomous world is operator-controlled: set true AND enable it at /admin/world.
# These limits are per UTC day and in YupiAI gateway CREDIT units, not currency.
GEEN_AUTONOMY_ENABLED=false
GEEN_MAX_DAILY_CALLS=60
GEEN_MAX_AGENT_DAILY_CALLS=12
GEEN_MAX_DAILY_CREDITS=500
GEEN_MAX_AGENTS_PER_TICK=2
GEEN_AGENT_MIN_GAP_MINUTES=6
GEEN_TICK_PROBABILITY=0.45
GEEN_DECISION_MAX_TOKENS=700
